generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SELLER
}

/// Access control for the members area (not commercial pipeline stage).
enum ApprovalStatus {
  PENDING
  ACTIVE
  REFUSED
  PAUSED
  CANCELLED
  BLOCKED
}

/// Commercial pipeline for leads/clients (independent from access status).
enum CommercialStage {
  NEW_LEAD
  CONTACT_MADE
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  AWAITING_REGISTRATION
  AWAITING_APPROVAL
  SALE_COMPLETED
  SALE_LOST
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ContentBlockType {
  TEXT
  STEP
  TIP
  WARNING
  IMAGE
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

enum BannerTargetType {
  CATEGORY
  MODULE
  URL
}

enum DashboardBlockType {
  BANNER
  CATEGORY
}

model UserProfile {
  id         String         @id @default(cuid())
  clerkId    String         @unique
  name       String
  email      String         @unique
  whatsapp   String?
  role       UserRole       @default(STUDENT)
  status     ApprovalStatus @default(PENDING)
  /// Commercial pipeline stage (leads/sales). Independent from access `status`.
  commercialStage CommercialStage @default(NEW_LEAD)
  /// Amount paid in centavos (BRL). Avoid floating point money.
  paidAmountCents Int @default(0)
  /// Seller responsible for this client (self-relation to a SELLER profile).
  sellerId   String?
  /// Soft archive — hidden from normal admin lists, history preserved.
  deletedAt  DateTime?
  /// Cached public avatar URL from Clerk (not base64).
  imageUrl   String?
  approvedAt DateTime?
  blockedAt  DateTime?
  blockReason String?
  adminNotes String?
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  seller              UserProfile?          @relation("ClientSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  clients             UserProfile[]         @relation("ClientSeller")
  lessonProgress      LessonProgress[]
  checklistCompletion ChecklistCompletion[]
  teamInvitesSent     TeamInvite[]          @relation("TeamInvitesSent")
  salesAsClient       Sale[]                @relation("SaleClient")
  salesAsSeller       Sale[]                @relation("SaleSeller")
  salesCreated        Sale[]                @relation("SaleCreatedBy")
  auditLogs           AdminAuditLog[]

  @@index([role, status])
  @@index([status, lastSeenAt])
  @@index([commercialStage, status])
  @@index([role, commercialStage])
  @@index([sellerId])
  @@index([deletedAt])
}

/// Manual sales ledger (no payment gateway in this phase).
model Sale {
  id               String     @id @default(cuid())
  clientId         String
  sellerId         String?
  amountInCents    Int
  status           SaleStatus @default(CONFIRMED)
  soldAt           DateTime
  notes            String?
  createdByAdminId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  client         UserProfile  @relation("SaleClient", fields: [clientId], references: [id], onDelete: Restrict)
  seller         UserProfile? @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  createdByAdmin UserProfile? @relation("SaleCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sellerId])
  @@index([soldAt])
  @@index([status, soldAt])
}

/// Minimal admin audit trail (no secrets/passwords).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  result     String
  meta       String?
  createdAt  DateTime @default(now())

  admin UserProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

model TeamInvite {
  id                String           @id @default(cuid())
  email             String
  role              UserRole
  status            TeamInviteStatus @default(PENDING)
  clerkInvitationId String?          @unique
  invitedById       String?
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  invitedBy UserProfile? @relation("TeamInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([role, status])
}

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  bannerUrl   String?
  hideText    Boolean       @default(false)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categorias      Categoria[]
  modules         Module[]
  dashboardBlocks DashboardBlock[]
}

model Banner {
  id         String            @id @default(cuid())
  imageUrl   String?
  title      String?
  subtitle   String?
  order      Int
  status     BannerStatus      @default(ACTIVE)
  targetType BannerTargetType?
  targetId   String?
  targetUrl  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  images         BannerImage[]
  dashboardBlock DashboardBlock?

  @@unique([order])
  @@index([status, order])
}

model BannerImage {
  id        String   @id @default(cuid())
  bannerId  String
  imageUrl  String
  altText   String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([bannerId, order])
  @@index([bannerId, order])
}

model Categoria {
  id             String        @id @default(cuid())
  courseId       String
  title          String
  description    String?
  coverImagePath String?
  order          Int
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules        Module[]
  dashboardBlock DashboardBlock?

  @@unique([courseId, order])
  @@index([courseId, status, order])
}

model DashboardBlock {
  id          String             @id @default(cuid())
  courseId    String
  type        DashboardBlockType
  order       Int
  bannerId    String?            @unique
  categoriaId String?            @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  banner    Banner?    @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([courseId, type, order])
}

model Module {
  id             String        @id @default(cuid())
  courseId       String
  categoriaId    String
  number         String
  title          String
  objective      String?
  coverImagePath String?
  hideText       Boolean       @default(false)
  order          Int
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  lessons   Lesson[]

  @@unique([categoriaId, order])
  @@index([courseId, status, order])
  @@index([categoriaId, status, order])
}

model Lesson {
  id           String        @id @default(cuid())
  moduleId     String
  number       String
  title        String
  objective    String?
  context      String?
  order        Int
  status       ContentStatus @default(PUBLISHED)
  tipKind      String?
  tipText      String?
  imagePath    String?
  imageCaption String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks         ContentBlock[]
  checklistItems ChecklistItem[]
  progress       LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId, status, order])
}

model ContentBlock {
  id           String           @id @default(cuid())
  lessonId     String
  type         ContentBlockType
  order        Int
  content      String
  imagePath    String?
  imageCaption String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@index([lessonId, type, order])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  lessonId  String
  text      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson      Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completions ChecklistCompletion[]

  @@unique([lessonId, order])
  @@index([lessonId, order])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

model ChecklistCompletion {
  id              String    @id @default(cuid())
  userId          String
  checklistItemId String
  checked         Boolean   @default(false)
  checkedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId])
  @@index([userId, checked])
}
