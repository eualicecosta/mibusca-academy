# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/aguardando-aprovacao"

# Supabase Storage antigo, usado apenas para migrar imagens existentes para o R2
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ey..."
SUPABASE_STORAGE_BUCKET="course-images"

# Cloudflare R2 para imagens novas e migradas
R2_ACCOUNT_ID="[cloudflare-account-id]"
R2_ACCESS_KEY_ID="[r2-access-key-id]"
R2_SECRET_ACCESS_KEY="[r2-secret-access-key]"
R2_BUCKET_NAME="course-images"
R2_PUBLIC_BASE_URL="https://[dominio-publico-ou-r2-dev]"
# Opcional: use apenas se quiser sobrescrever o endpoint padrao https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
# Opcional: use "false" para manter caminhos relativos no banco ao migrar referencias.
# MIGRATE_IMAGE_REFERENCES_AS_ABSOLUTE="true"

# Admin inicial criado pelo seed, depois de criar sua conta no Clerk
ADMIN_CLERK_ID="user_..."
ADMIN_EMAIL="admin@mibuscabrasil.com"
ADMIN_NAME="Admin MiBusca"
